---
/** Swedish about page — `/about/`. English is served by `[locale]/[slug].astro`. */
import Layout from '$lib/layouts/Layout.astro';
import AboutPage from '$lib/components/pages/about-page/about-page.astro';
import { useTranslations } from '$lib/i18n';

const locale = 'sv' as const;
const t = useTranslations(locale);
---

<Layout {locale} routeKey="about" title={t.meta.aboutTitle} description={t.meta.aboutDescription}>
    <AboutPage {locale} />
</Layout>
