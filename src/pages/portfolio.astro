---
/** Swedish portfolio page — `/portfolio/`. English is served by `[locale]/[slug].astro`. */
import Layout from '$lib/layouts/Layout.astro';
import PortfolioPage from '$lib/components/pages/portfolio-page/portfolio-page.astro';
import { useTranslations } from '$lib/i18n';

const locale = 'sv' as const;
const t = useTranslations(locale);
---

<Layout {locale} routeKey="portfolio" title={t.meta.portfolioTitle}>
    <PortfolioPage {locale} />
</Layout>
