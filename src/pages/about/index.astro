---
import Layout from '$lib/layouts/Layout.astro';
import AboutPage from '$lib/components/pages/about-page/about-page.astro';
import { getLocale } from '$lib/paraglide/runtime';
import { useTranslations } from '$lib/i18n';

// Paraglide still owns locale detection until the static cut-over (task 6).
const locale = getLocale();
const t = useTranslations(locale);
---

<Layout {locale} routeKey="about" title={t.meta.aboutTitle}>
    <AboutPage {locale} />
</Layout>
